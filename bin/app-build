#!/usr/bin/env bash
# Build the release bundle so it REALLY contains the current frontend.
# Cargo does not notice a changed dist/ on its own: touch the file that embeds it.
# usage: bin/app-build [literal string that must be in the built frontend]
set -euo pipefail
cd "$(dirname "$0")/.."
touch desktop/src-tauri/src/main.rs
# The release config and bin/version, like a CI release (see install-local.mjs): the running copy
# is then offered only newer releases, and updates in place.
V=$(bin/version)
(cd desktop && yarn -s tauri build --bundles app -c src-tauri/tauri.release.conf.json --config "{\"version\":\"$V\",\"bundle\":{\"createUpdaterArtifacts\":false}}" 2>&1 | grep -E "Bundling|^error" | tail -1)
# The embedded assets are brotli-compressed inside the binary, so the check reads the
# built dist instead: it is what the bundle step just embedded.
if [ -n "${1:-}" ]; then
  # grep reads the files itself: `cat | grep -q` under pipefail fails when grep stops early on a match.
  /usr/bin/grep -Fq -- "$1" desktop/dist/assets/*.js || { echo "dist lacks: $1" >&2; exit 1; }
  echo "dist has: $1"
fi
