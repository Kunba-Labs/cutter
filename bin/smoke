#!/usr/bin/env bash
# End-to-end check on a scratch library: a spoken test clip → download → whisper → claude → render.
# usage: bin/smoke [video.mp4]   (no arg: synthesises a 60 s English lecture with `say`)
set -euo pipefail
cd "$(dirname "$0")/.."
export CUTTAR_DATA_DIR=/tmp/cuttar-smoke/data CUTTAR_PORT=47299
rm -rf /tmp/cuttar-smoke/data; mkdir -p /tmp/cuttar-smoke
CLI=target/debug/cuttar
cargo build -q -p cuttar >/dev/null
VID=${1:-/tmp/cuttar-smoke/lecture.mp4}
if [ ! -f "$VID" ]; then
  say -v Daniel -r 175 -o /tmp/cuttar-smoke/speech.aiff "Patience is not waiting until the difficulty is over. Patience is continuing while it is difficult. That is the difference. The Prophet, peace be upon him, said: amazing is the affair of the believer, all of it is good for him. If something good reaches him he is grateful, and that is good for him. And if something harmful reaches him he is patient, and that is good for him. Now let us return to the verse. We created man in toil. Some commentators say this is about birth, the first struggle of a human being. Others say it is about standing upright, that a person must carry and must work. Ibn Kathir mentions both. And then comes the verse about the two paths. We have shown him the two ways. This is one of my favourite verses, because it says: you have a choice. Every day. Not once in your life, but every single day again."
  ffmpeg -y -loglevel error -f lavfi -i "color=c=0x1a1d2a:s=1920x1080:r=30" -i /tmp/cuttar-smoke/speech.aiff -shortest -c:v libx264 -preset ultrafast -c:a aac "$VID"
fi
$CLI headless > /tmp/cuttar-smoke/headless.log 2>&1 &
HP=$!
trap 'kill $HP 2>/dev/null || true' EXIT
for i in $(seq 1 40); do curl -s http://127.0.0.1:$CUTTAR_PORT/health >/dev/null && break; sleep 0.5; done
$CLI settings patch:='{"outDir":"/tmp/cuttar-smoke/out"}' >/dev/null
SRC=$($CLI add "$VID" language=en | python3 -c 'import sys,json; print(json.load(sys.stdin)["id"])')
echo "source $SRC"
for i in $(seq 1 240); do
  STAGE=$($CLI source id=$SRC | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d["source"]["stage"], "|", d["source"].get("error") or "", "|", len(d["candidates"]))')
  echo "  $i: $STAGE"
  case "$STAGE" in review*|failed*|done*) break;; esac
  sleep 5
done
$CLI source id=$SRC | python3 -c '
import sys, json
d = json.load(sys.stdin); t = d["transcript"]
print("transcript:", t and t["language"], t and len(t["segments"]), "segments")
for c in d["candidates"]:
    print("  %s %-10s %6.1f-%6.1f %s%s" % (c["score"], c["category"], c["start"], c["end"], c["title"], " ✓" if c["approved"] else ""))
'
echo "approved: $($CLI approve_above sourceId=$SRC score=1)"
echo "render jobs: $($CLI render sourceId=$SRC formats:='["shorts"]' | tr -d '\n ')"
for i in $(seq 1 60); do
  LEFT=$($CLI jobs | python3 -c 'import sys,json; print(sum(1 for j in json.load(sys.stdin) if j["status"] in ("queued","running")))')
  [ "$LEFT" = "0" ] && break; sleep 3
done
$CLI jobs | python3 -c '
import sys, json
for j in json.load(sys.stdin):
    print("  %-12s %-9s %s" % (j["kind"], j["status"], j["message"][:90]))
'
$CLI source id=$SRC | python3 -c 'import sys,json; d=json.load(sys.stdin); [print("render:", r["status"], r["path"]) for r in d["renders"]]'
