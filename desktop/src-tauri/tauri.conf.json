{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cuttar",
  "mainBinaryName": "Cuttar",
  "version": "0.1.0",
  "identifier": "com.cuttar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5230",
    "beforeDevCommand": "lsof -ti:5230 >/dev/null 2>&1 || yarn vite",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": [26, 29, 42, 255],
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 22 },
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$HOME/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Video",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
